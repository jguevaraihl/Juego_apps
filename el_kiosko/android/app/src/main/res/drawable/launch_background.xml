<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo que Android muestra mientras arranca el proceso, antes de que
     Flutter pinte su primer frame.

     Va en el crema del juego y no en blanco: con blanco se ve un destello
     claro en cada arranque, que es de las cosas que más hacen sentir barata
     una app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
